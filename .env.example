# Copy this file to .env.local and fill in only the providers you want to use.
# Do not commit .env.local.

# OpenAI Responses adapter
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Messages adapter
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_MAX_TOKENS=4096

# Ollama local adapter
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Bounded local per-run allowance for official subscription CLI calls.
# Lower values are allowed; the orchestrator never raises this default itself.
UO_SUBSCRIPTION_CALL_LIMIT=12

# Optional render tools for serious/max artifact validation.
# UO_PDFTOPPM_BIN=pdftoppm
# UO_SOFFICE_BIN=soffice
